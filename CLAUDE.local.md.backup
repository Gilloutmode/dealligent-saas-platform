## SECURITE WEBHOOKS (OWASP API 2023)

### Authentication JWT (Clerk)
```javascript
// Validation complete du JWT
const validateJWT = async (authHeader) => {
  if (!authHeader?.startsWith('Bearer ')) {
    return { valid: false, error: 'Missing Bearer token' };
  }

  const token = authHeader.slice(7);

  try {
    // Verifier avec Clerk public key
    const payload = await verifyClerkJWT(token);

    // Verifier expiration
    if (payload.exp < Date.now() / 1000) {
      return { valid: false, error: 'Token expired' };
    }

    // Verifier issuer
    if (payload.iss !== 'https://clerk.your-domain.com') {
      return { valid: false, error: 'Invalid issuer' };
    }

    return {
      valid: true,
      tenantId: payload.org_id,
      userId: payload.sub,
      roles: payload.roles || []
    };
  } catch (error) {
    return { valid: false, error: `JWT verification failed: ${error.message}` };
  }
};
```

### HMAC Signature (Webhooks Externes)
```javascript
const crypto = require('crypto');

const verifyHMAC = (payload, signature, secret) => {
  const expectedSig = crypto
    .createHmac('sha256', secret)
    .update(typeof payload === 'string' ? payload : JSON.stringify(payload))
    .digest('hex');

  // Timing-safe comparison (prevent timing attacks)
  try {
    return crypto.timingSafeEqual(
      Buffer.from(signature.replace('sha256=', '')),
      Buffer.from(expectedSig)
    );
  } catch {
    return false;
  }
};
```

